# Environment Variables Example
# Copy this to .env and fill in your values

# =============================================================
# SERVER
# =============================================================
PORT=3000
NODE_ENV=development

# =============================================================
# AUTONOMOUS SCHEDULER
# Set how often the agent runs its autonomous cycle (seconds)
# =============================================================
# Fast development interval (default 60s for demo)
DEV_AUTONOMOUS_INTERVAL=60
# Production interval (default 1 hour)
PROD_AUTONOMOUS_INTERVAL=3600

# Which interval to use (auto-selected based on NODE_ENV)
# Override here to force a specific interval:
# AUTONOMOUS_INTERVAL=120

# =============================================================
# LLM PROVIDER (optional - built-in synthesis used if absent)
# =============================================================
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# =============================================================
# DATABASE
# =============================================================
# SQLite file path (relative to project root)
DB_PATH=./data/agent.db

# =============================================================
# WEB SEARCH / NEWS DISCOVERY (optional)
# =============================================================
# NEWS_API_KEY=your_newsapi_key_here

# =============================================================
# CORS
# =============================================================
CORS_ORIGIN=*
